# ~/.openclaw/.env  起手模板
#
# 拷贝到 ~/.openclaw/.env 后 chmod 600；不要提交到任何仓库。
#
# OpenClaw 启动时会读取以下环境变量（来自 dist/extensions/zai/openclaw.plugin.json
# 的 providerAuthEnvVars）。Key 不写在 openclaw.json 里，由这里注入更安全。

# ====== 智谱 GLM Coding Plan ======
# 控制台：https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
# 必须订阅 GLM Coding Plan，端点用 open.bigmodel.cn/api/coding/paas/v4
ZAI_API_KEY=

# 备用别名（与 ZAI_API_KEY 等价；OpenClaw 两个都认）
# Z_AI_API_KEY=

# ====== 安装期间可选环境变量（被官方 install.sh 识别）======
# 设置后 install.sh 会自动取，省得每次传 --xxx
# OPENCLAW_NO_PROMPT=1
# OPENCLAW_NO_ONBOARD=1
# OPENCLAW_VERSION=latest
# OPENCLAW_PROFILE=
# OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_WORKSPACE=$HOME/openclaw

# ====== 微信通道凭证（iLink/gewechat/企业微信由 onboard 写入到 openclaw.json，
#         凭证会通过 SecretRef 引用环境变量，这里仅占位）======
# WEIXIN_BOT_TOKEN=
# WEIXIN_ACCOUNT_ID=
