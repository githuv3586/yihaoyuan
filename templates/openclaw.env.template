# ~/.openclaw/.env  起手模板
# 拷贝到 ~/.openclaw/.env 后 chmod 600；不要提交到任何仓库。

# ====== 智谱 GLM Coding Plan ======
# 控制台：https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZAI_API_KEY=
# 端点必须是 coding/paas/v4，不是普通 paas/v4，否则计费走错套餐
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# 主模型（Coding Plan 仅允许：glm-5-turbo / glm-5.1 / glm-4.7 / glm-4.5-air）
ZAI_MODEL=glm-5-turbo

# ====== 自治 Agent（按需，详见 docs/OPENCLAW_FULL_AUTONOMY.md）======
OPENCLAW_AUTONOMY_LEVEL=3
OPENCLAW_BUDGET_TOKENS=50000
OPENCLAW_BUDGET_TIME_MS=300000

# ====== 微信通道（iLink / gewechat / 企业微信，安装向导会回填）======
# WEIXIN_ACCOUNT_ID=
# WEIXIN_TOKEN=
WEIXIN_DM_POLICY=open
WEIXIN_GROUP_POLICY=allowlist
WEIXIN_ALLOWED_USERS=
WEIXIN_GROUP_ALLOWED_USERS=

# ====== 日志 / 缓存 ======
OPENCLAW_LOG_LEVEL=info
OPENCLAW_CACHE_L1=true
OPENCLAW_CACHE_L2=true

# ====== 管理员（可执行 /admin 指令的 wxid 列表，逗号分隔）======
OPENCLAW_ADMINS=
