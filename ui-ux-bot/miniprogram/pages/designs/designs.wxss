/* pages/designs/designs.wxss */
.designs-container { padding: 24rpx; padding-bottom: 120rpx; }

.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }

.tab {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: #F1F5F9;
  color: #64748B;
}

.tab.active { background: #2563EB; color: #fff; }

.design-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.design-header { display: flex; justify-content: space-between; align-items: center; }

.design-title { font-size: 30rpx; font-weight: 600; color: #1E293B; flex: 1; }

.design-fav { font-size: 36rpx; padding: 8rpx; }

.design-meta { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 16rpx 0; }

.color-preview { display: flex; gap: 12rpx; margin: 16rpx 0; }

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #E2E8F0;
}

.design-time { font-size: 22rpx; color: #94A3B8; }

.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 32rpx; color: #475569; font-weight: 500; }
.empty-hint { font-size: 24rpx; color: #94A3B8; margin-top: 12rpx; }

.loading-dots { display: flex; justify-content: center; gap: 12rpx; padding: 40rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #93C5FD; animation: bounce 1.4s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes bounce { 0%,80%,100% { transform: scale(0); } 40% { transform: scale(1); } }
