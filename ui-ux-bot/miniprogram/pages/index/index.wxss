/* pages/index/index.wxss */
.container {
  padding-bottom: 160rpx;
}

.hero {
  background: linear-gradient(135deg, #2563EB, #7C3AED);
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
  color: #fff;
}

.hero-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 28rpx;
  opacity: 0.85;
  margin-bottom: 24rpx;
}

.hero-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.hero-tags .tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 24rpx;
}

/* 快捷入口 */
.shortcut-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.shortcut-item {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  transition: all 0.2s;
}

.shortcut-item:active {
  background: #EFF6FF;
  border-color: #93C5FD;
}

.shortcut-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.shortcut-text {
  font-size: 24rpx;
  color: #475569;
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feature-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E293B;
}

.feature-desc {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 4rpx;
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.bottom-action .btn-primary {
  width: 100%;
}
