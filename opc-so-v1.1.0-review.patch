 function serveFile(req, res, filePath) {
   fs.stat(filePath, (err, stat) => {
     if (err || !stat.isFile()) {
-      // SPA fallback：未找到的页面回退到 index.html（仅对非资源请求）
+      // 资源类请求（带扩展名，如 .js/.css/.png）找不到就直接 404，
+      // 避免回退到 index.html + 200 掩盖真实错误、返回错误的 Content-Type。
+      const ext = path.extname(filePath).toLowerCase();
+      if (ext && ext !== '.html') {
+        return sendJSON(res, 404, { error: 'Not Found' }, req);
+      }
+      // SPA fallback：仅对无扩展名的「页面路由」回退到 index.html
       const fallback = path.join(__dirname, 'index.html');
       fs.stat(fallback, (e2, s2) => {
         if (e2 || !s2.isFile()) return sendJSON(res, 404, { error: 'Not Found' }, req);
@@ -308,10 +327,26 @@ ${policyList}`;
